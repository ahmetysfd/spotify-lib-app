# ============================================
# SPOTIFY MUSIC STATS - ENV CONFIG
# ============================================
# Copy this file to .env.local and fill in your values THERE.
# NEVER put real API keys, secrets, or passwords in THIS file —
# .env.example is committed to Git. Use placeholders only here.
# ============================================

# ── NextAuth ─────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Spotify API ──────────────────────────────
# Get these from https://developer.spotify.com/dashboard
# IMPORTANT: Set redirect URI in Spotify Dashboard to:
#   http://localhost:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ── Database ─────────────────────────────────
# PostgreSQL (required for Vercel). Get a free DB at https://neon.tech
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/spotify_library?sslmode=require"

# ── Cron (optional) ──────────────────────────
# Required if you run the "collect recently played" job every 2 hours.
# Generate a secret: openssl rand -base64 32
# Set this in Vercel (or your host) and use the same value in your cron trigger.
# CRON_SECRET=your-cron-secret-here

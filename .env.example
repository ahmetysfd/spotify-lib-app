# ============================================
# SPOTIFY MUSIC STATS - ENV CONFIG
# ============================================
# Copy this file to .env.local and fill in your values

# ── NextAuth ─────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Spotify API ──────────────────────────────
# Get these from https://developer.spotify.com/dashboard
# IMPORTANT: Set redirect URI in Spotify Dashboard to:
#   http://localhost:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ── Database ─────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Cron (optional) ──────────────────────────
# Required if you run the "collect recently played" job every 2 hours.
# Generate a secret: openssl rand -base64 32
# Set this in Vercel (or your host) and use the same value in your cron trigger.
# CRON_SECRET=your-cron-secret-here
